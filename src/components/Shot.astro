---
import { url } from '../lib/url'

interface Props {
  /** Base name in /public/media, without the -800/-1600 suffix. */
  name: string
  alt: string
  caption?: string
  width?: number
  height?: number
  eager?: boolean
  sizes?: string
}

const { name, alt, caption, width = 1600, height = 897, eager = false, sizes = '(min-width: 1120px) 1040px, 100vw' } = Astro.props
---

<figure class="figure">
  <img
    src={url(`media/${name}-1600.webp`)}
    srcset={`${url(`media/${name}-800.webp`)} 800w, ${url(`media/${name}-1600.webp`)} 1600w`}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
