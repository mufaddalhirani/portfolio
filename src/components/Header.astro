---
import { url } from '../lib/url'

interface Props { current: string }
const { current } = Astro.props

const links = [
  { href: url('#work'), label: 'Work', key: 'work' },
  { href: url('about/'), label: 'About', key: 'about' },
  { href: url('cv/'), label: 'CV', key: 'cv' },
]
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href={url('')} aria-label="Mufaddal Hirani, home">
      Mufaddal Hirani
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        <li>
          <button class="theme" type="button" aria-label="Switch colour theme" title="Switch colour theme">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme')
  button?.addEventListener('click', () => {
    const root = document.documentElement
    const systemDark = matchMedia('(prefers-color-scheme: dark)').matches
    const now = root.dataset.theme ?? (systemDark ? 'dark' : 'light')
    const next = now === 'dark' ? 'light' : 'dark'
    root.dataset.theme = next
    try { localStorage.setItem('theme', next) } catch {}
  })
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 16px; }
  .name { font-family: var(--serif); font-size: 24px; text-decoration: none; white-space: nowrap; }
  ul { display: flex; align-items: center; gap: clamp(14px, 3vw, 28px); list-style: none; margin: 0; padding: 0; }
  nav a { font-size: 15px; text-decoration: none; color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); }
  .theme {
    display: grid; place-items: center; width: 36px; height: 36px; margin-right: -8px;
    border: 0; background: none; color: var(--muted); cursor: pointer; border-radius: 8px;
  }
  .theme:hover { color: var(--text); background: var(--sunken); }
  @media (max-width: 420px) { .name { font-size: 21px; } }
</style>
