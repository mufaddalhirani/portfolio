---
import { site, url } from '../lib/url'
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="eyebrow">Get in touch</p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <p class="muted small">Open to internships and junior roles, remote or in Germany.</p>
    </div>
    <ul class="links">
      <li><a href={site.github} rel="me">GitHub</a></li>
      <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={url('cv/')}>CV</a></li>
      <li><a href={url('privacy/')}>Privacy &amp; legal notice</a></li>
    </ul>
  </div>
  <div class="wrap fine">
    <span>No cookies, no tracking, no third-party requests.</span>
    <span>Updated {site.updated} · <a href="https://github.com/mufaddalhirani/portfolio">Source</a></span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 56px 32px; margin-top: 40px; }
  .grid { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .mail { font-family: var(--serif); font-size: clamp(28px, 4vw, 40px); text-decoration: none; line-height: 1.1; word-break: break-word; }
  .mail:hover { text-decoration: underline; }
  .small { font-size: 15px; margin: 12px 0 0; }
  .links { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; align-content: start; }
  .links a { text-decoration: none; color: var(--muted); }
  .links a:hover { color: var(--text); }
  .fine {
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    margin-top: 48px; font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
</style>
