{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes http-server@14.1.1 _lh -p 8080 -s",
      "startServerReadyPattern": "Available on",
      "url": [
        "http://localhost:8080/portfolio/",
        "http://localhost:8080/portfolio/work/lyrigen/",
        "http://localhost:8080/portfolio/work/extensions/",
        "http://localhost:8080/portfolio/about/",
        "http://localhost:8080/portfolio/cv/",
        "http://localhost:8080/portfolio/privacy/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
